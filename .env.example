# Per-venture Vercel env (same Supabase pair for all; Stripe per account; Resend optional)
SUPABASE_URL=https://zzdnnxqewqlfrdmbxwln.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase dashboard → project settings → API → service_role
STRIPE_SECRET_KEY=                    # Stripe dashboard → developers → API keys
STRIPE_WEBHOOK_SECRET=                # printed by scripts/setup-stripe.mjs --webhooks <url>
RESEND_API_KEY=                       # optional — order confirmations; leads work without it
EMAIL_FROM=                           # e.g. "Desk <hello@yourdomain.com>" — must be Resend-verified
