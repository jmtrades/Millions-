# Supabase auth + data (user-facing paths — anon key only, RLS enforced).
# The app builds and renders a graceful "auth not configured" state without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: portfolio lead/event capture (server-side, shared m_* tables — see 0001_init.sql).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
